rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an authorized admin
    function isSuperAdmin() {
      return request.auth != null && 
        (request.auth.token.email.lower() == 'ngdcsc.org@gmail.com' || 
         request.auth.token.email.lower() == 'info.tamimiq@gmail.com' ||
         request.auth.token.email.lower() == 'tahmidahmmed007@gmail.com');
    }

    // 1. Club Notices: Anyone can read; only authorized club admin can create/edit/delete
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 2. Executive Committee: Anyone can read; only authorized club admin can create/edit/delete
    match /executive_committee/{memberId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Helper to check if signed-in member owns the member document
    function isMemberOwner() {
      return request.auth != null && (
        (resource.data.uid != null && resource.data.uid == request.auth.uid) ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
      );
    }

    // 3. Member Registrations: Anyone can submit registration (create) and check status (read);
    // authorized admin can update/delete; signed-in owner can update profile only when admin allows member editing,
    // and Roll (studentId), phone, email & review fields remain strictly locked
    match /members/{memberId} {
      allow create, read: if true;
      allow update: if isSuperAdmin() || (
        isMemberOwner() &&
        (!exists(/databases/$(database)/documents/settings/membership_registration) ||
         get(/databases/$(database)/documents/settings/membership_registration).data.get('allowMemberEdit', true) == true) &&
        request.resource.data.get('studentId', null) == resource.data.get('studentId', null) &&
        request.resource.data.get('phone', null) == resource.data.get('phone', null) &&
        request.resource.data.get('email', null) == resource.data.get('email', null) &&
        request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') &&
        request.resource.data.get('membershipId', null) == resource.data.get('membershipId', null) &&
        request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null)
      );
      allow delete: if isSuperAdmin();
    }

    // 4. Public Member Status Search: Anyone can read status by phone key; create/update allowed for submission & admin
    match /member_status/{phoneKey} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // 5. System & Club Settings (e.g. membership registration open/closed status)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 6. Email Dispatch & Activity Logs: Only authorized club admin can read/write
    match /email_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // 7. Attendance Sessions (date + event title metadata only, zero PII):
    // Signed-in members and admins can read session dates; only authorized admin can create/edit/delete
    match /attendance_sessions/{sessionDate} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // 8. Member Attendance Records:
    // Strictly isolated: authorized admin can read/write all attendance records;
    // an individual signed-in member can ONLY read their own attendance records.
    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin() || (
        request.auth != null && (
          resource.data.memberUid == request.auth.uid ||
          resource.data.memberEmail == request.auth.token.email ||
          resource.data.memberEmailLower == request.auth.token.email.lower()
        )
      );
      allow create, update, delete: if isSuperAdmin();
    }

    // Helper: strictly matches President account (Tamim Iqbal)
    function isPresident() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'info.tamimiq@gmail.com';
    }

    // Helper: matches the specific member who owns a given Inbox thread
    function isThreadMemberOwner(threadData) {
      return request.auth != null && (
        (threadData.get('memberUid', null) != null && threadData.get('memberUid', null) == request.auth.uid) ||
        (threadData.get('memberEmailLower', null) != null &&
         request.auth.token.email != null &&
         threadData.get('memberEmailLower', null) == request.auth.token.email.lower())
      );
    }

    // 9. President <-> Individual Member Private Inbox Threads & Chat History
    // Only President (info.tamimiq@gmail.com / Tamim Iqbal) can message any member individually;
    // every other member can ONLY read and write their own direct thread with Tamim Iqbal.
    match /inbox_threads/{threadId} {
      allow read: if isPresident() || isThreadMemberOwner(resource.data);
      allow create: if isPresident() || (
        request.auth != null &&
        request.auth.token.email != null &&
        request.resource.data.get('memberEmailLower', '') == request.auth.token.email.lower() &&
        request.resource.data.get('lastSenderRole', '') == 'member'
      );
      allow update: if isPresident() || (
        isThreadMemberOwner(resource.data) &&
        request.resource.data.get('memberEmailLower', '') == resource.data.get('memberEmailLower', '') &&
        request.resource.data.get('memberId', '') == resource.data.get('memberId', '') &&
        (
          resource.data.get('memberUid', null) == null ||
          request.resource.data.get('memberUid', null) == resource.data.get('memberUid', null)
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isPresident() || (
          exists(/databases/$(database)/documents/inbox_threads/$(threadId)) &&
          isThreadMemberOwner(get(/databases/$(database)/documents/inbox_threads/$(threadId)).data)
        );
        allow create: if request.auth != null &&
          request.auth.token.email != null &&
          request.resource.data.senderEmailLower == request.auth.token.email.lower() &&
          (
            (isPresident() && request.resource.data.senderRole == 'president') ||
            (!isPresident() &&
             request.resource.data.senderRole == 'member' &&
             exists(/databases/$(database)/documents/inbox_threads/$(threadId)) &&
             isThreadMemberOwner(get(/databases/$(database)/documents/inbox_threads/$(threadId)).data))
          );
        allow update, delete: if false;
      }
    }

    // 10. System metadata (serial counters)
    match /system_meta/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Fallback: Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
