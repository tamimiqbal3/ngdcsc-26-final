{
  "headers": [
    {
      "source": "/(sw\\.js|sw-notify\\.js|firebase-messaging-sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js|sw-notify\\.js|firebase-messaging-sw\\.js|manifest\\.webmanifest|sitemap\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
