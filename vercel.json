{
  "headers": [
    {
      "source": "/(sw\\.js|sw-notify\\.js|firebase-messaging-sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw\\.js|sw-notify\\.js|firebase-messaging-sw\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
